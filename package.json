{
  "name": "cordiale-private-cocktail-bar",
  "version": "1.0.0",
  "private": true,
  "description": "Private Cocktail Bar Roma — sito, configuratore preventivi e admin panel",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:retention": "tsx scripts/retention.ts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts scripts/create-admin.ts scripts/retention.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist-scripts --external:pg-native --out-extension:.js=.cjs --log-level=warning"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.12",
    "next": "15.5.25",
    "nodemailer": "10.0.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "typescript": "5.9.3"
  }
}
