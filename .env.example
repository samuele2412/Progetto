# =============================================================================
# Cordiale — Private Cocktail Bar Roma
# Copy this file to .env and fill it in. Never commit .env.
# =============================================================================

# --- Public address ----------------------------------------------------------
# The canonical origin, no trailing slash. Used for canonical URLs, hreflang,
# the sitemap and the links inside notification emails.
#
# It also decides how the session cookie is issued: an https origin gets Secure
# and the __Host- prefix, an http one does not (a Secure cookie over plain http
# is discarded by the browser and the panel would loop on the login page).
# For local development use:  SITE_URL=http://localhost:3000
SITE_URL=https://your-domain.example

# --- Database ----------------------------------------------------------------
# With docker compose, the host is the service name ("db") and the password must
# match POSTGRES_PASSWORD below.
POSTGRES_USER=cordiale
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=cordiale
DATABASE_URL=postgresql://cordiale:change-me-to-a-long-random-password@db:5432/cordiale

# --- Secrets -----------------------------------------------------------------
# Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-characters-long-random-string
# Salt for the one-way hash of visitor IPs used by the anti-spam throttle.
# Generate with:  openssl rand -hex 24
IP_HASH_SALT=change-me-random-hex

# Which request header the rate limiter reads the client IP from. It MUST be a
# header written by the proxy in front of the app: anything a client can set
# itself turns the anti-spam and login throttles off completely.
#   cf-connecting-ip  (default) — behind Cloudflare Tunnel, as documented
#   x-forwarded-for / x-real-ip — behind your own nginx/Traefik
#   none                        — nothing in front; everyone shares one bucket
TRUSTED_IP_HEADER=cf-connecting-ip
# How long an admin session lasts.
SESSION_TTL_HOURS=12

# --- First administrator -----------------------------------------------------
# Read once by scripts/install.sh (and `npm run admin:create` with no arguments)
# to create the account. Remove the password from this file afterwards.
ADMIN_EMAIL=you@your-domain.example
ADMIN_PASSWORD=choose-a-long-password-at-least-12-characters
ADMIN_NAME=
# The entrypoint only *creates* a missing account: it never resets an existing
# password, which would undo a change made from the panel on every restart.
# Set this to true for one boot if you need to force a reset.
ADMIN_RESET_PASSWORD=false

# --- Email notifications (optional but strongly recommended) -----------------
# Without these the site still records every request — you just have to open the
# panel to see them. Use a transactional provider or your own mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Cordiale <no-reply@your-domain.example>"
# Where new-request notifications are delivered.
NOTIFY_EMAIL=you@your-domain.example

# --- Anti-spam (optional) ----------------------------------------------------
# Leave empty to rely on the honeypot, the timing check and the rate limiter.
# Add Turnstile keys only if real spam starts arriving.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Requests accepted from one IP per hour before the form starts refusing.
# Only successful submissions count: a typo in an email does not use one up.
RATE_LIMIT_PER_HOUR=5

# --- HTTPS hardening ---------------------------------------------------------
# includeSubDomains and preload are hard to undo: they force EVERY subdomain to
# https for the whole max-age. Turn them on only once you are sure the entire
# domain is served over https.
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# --- Analytics (optional, privacy-first) -------------------------------------
# A self-hosted Umami or Plausible script. Both are cookieless, which is why the
# site needs no consent banner. See docs/10-analytics.md.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=

# --- Uploads -----------------------------------------------------------------
# Inside the container this must stay under public/ so the files are served.
UPLOAD_DIR=/app/public/uploads
MAX_UPLOAD_MB=6

# --- Retention ---------------------------------------------------------------
# Months after which unconverted requests are deleted by `npm run db:retention`.
RETENTION_MONTHS=24
# Converted events are kept far longer (contract and tax documents), but not for
# ever. Ten years is the Italian bookkeeping term.
RETENTION_MONTHS_COMPLETED=120

# Timezone used for every date shown and stored by the site. Container images
# run in UTC, which puts Italian evenings on the wrong calendar day.
# Half of this value is compiled into the browser bundle (the date picker has to
# know what "today" is), so after changing it rebuild rather than just restart:
#   docker compose up -d --build
SITE_TIME_ZONE=Europe/Rome

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Which address on the host the app is published on.
#   127.0.0.1  (default) only this machine — cloudflared reaches it, the LAN does not
#   192.168.x.y          also every device on your local network (phones, tablets)
#   0.0.0.0              every interface, including a public one if the machine has it
#
# Opening it to the LAN also opens /admin to everyone on that network, over plain
# HTTP. Use it for testing on your own phone, not as the way you run the site.
# When you do, set SITE_URL to the same address (e.g. http://192.168.0.82:3000)
# so the session cookie is issued in a form the browser will accept.
APP_BIND=127.0.0.1
APP_PORT=3000
